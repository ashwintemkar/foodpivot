# Backboard routes Gemma. The key is a Backboard key, not an OpenRouter key.
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL_NAME=gemma-4-26b-a4b-it

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Tiger Data (Timescale PostgreSQL). Local demo: docker compose up -d
# DATABASE_URL="postgresql://foodpilot:foodpilot@127.0.0.1:55432/foodpilot"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
