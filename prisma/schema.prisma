generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id
  email            String              @unique
  name             String?
  image            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  preferences      UserPreference?
  addresses        SavedAddress[]
  orders           Order[]
  recommendationRuns RecommendationRun[]
  agentEvents      AgentEvent[]
  conversations    Conversation[]

  @@map("users")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  displayName        String   @map("display_name")
  location           String
  lat                Float?
  lng                Float?
  diet               String
  spiceTolerance     Int      @map("spice_tolerance")
  allergies          String[]
  dislikes           String[]
  avoidOily          Boolean  @map("avoid_oily")
  comfortBudgetPaise Int      @map("comfort_budget_paise")
  people             Int
  deliveryPriority   String   @map("delivery_priority")
  preferredCuisines  String[] @map("preferred_cuisines")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  line      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_addresses")
}

model Restaurant {
  id        String   @id
  name      String
  cuisine   String
  rating    Float
  minutes   Int
  area      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")
  dishes    Dish[]
  orders    Order[]

  @@map("restaurants")
}

model Dish {
  id           String      @id
  restaurantId String      @map("restaurant_id")
  name         String
  cuisine      String
  family       String
  pricePaise   Int         @map("price_paise")
  rating       Float
  minutes      Int
  vegetarian   Boolean
  vegan        Boolean
  spice        Int
  oily         Boolean
  tags         String[]
  allergens    String[]
  description  String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([family])
  @@map("dishes")
}

model Order {
  id           String               @id
  userId       String               @map("user_id")
  restaurantId String               @map("restaurant_id")
  restaurant   String
  status       String
  itemSubtotal Int                  @map("item_subtotal")
  total        Int
  prompt       String?
  placedAt     DateTime             @map("placed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen      Restaurant           @relation(fields: [restaurantId], references: [id])
  items        OrderItem[]
  history      OrderStatusHistory[]

  @@index([userId, placedAt])
  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  dishId   String @map("dish_id")
  quantity Int
  name     String
  price    Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish     Dish   @relation(fields: [dishId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  status    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String
  text           String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model RecommendationRun {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  prompt    String
  pickDishId String? @map("pick_dish_id")
  score     Int?
  applied   String[]
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendation_runs")
}

model AgentEvent {
  id        String   @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  kind      String
  payload   Json
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@map("agent_events")
}
